{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voicin",
  "version": "1.0.0",
  "identifier": "com.voicin.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Voicin",
        "url": "index.html",
        "width": 300,
        "height": 380,
        "resizable": false,
        "maximizable": false,
        "alwaysOnTop": true,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Nhập bằng giọng nói vào con trỏ",
    "longDescription": "Nhấn và thả Ctrl để bật/tắt nghe. Chữ nói ra được gõ vào vị trí con trỏ ở bất kỳ ứng dụng nào.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Vietnamese",
          "English"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
