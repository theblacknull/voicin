# Set these in Vercel: Project Settings > Environment Variables (never commit a real .env file)

# Wallet that receives USDT (EVM: BSC/ETH)
TREASURY_EVM=0xYOUR_WALLET_ADDRESS
# Lifetime price in USDT
PRICE_USDT=10
# License keys, comma-separated (the initial 100 are kept in your local .env)
LICENSE_KEYS=VOIC-XXXX-XXXX-XXXX-XXXX
# Created automatically by the Upstash Redis integration on Vercel
REDIS_URL=redis://default:PASSWORD@HOST:6379
